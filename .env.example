# =====================================================================
# MA360 SamaritanLink — environment variables (EXAMPLE)
# Copy to `.env` for local development. NEVER commit the real `.env`.
# =====================================================================

# --- Application ---
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="MA360 SamaritanLink"

# --- Session / Auth ---
# Secret used to sign the demo session cookie. Generate a long random string.
SESSION_SECRET="replace-with-a-long-random-string"

# --- Database ---
# Local development (SQLite): file-based, zero setup.
#   DATABASE_URL="file:./dev.db"
# Production (PostgreSQL): e.g. Vercel Postgres / Neon / Supabase.
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
DATABASE_URL="file:./dev.db"

# --- Health Navigator "brain" (Cloudflare Worker + Workers AI) ---
# URL of the deployed Worker that runs the free Llama model. When unset, the
# Navigator falls back to curated mock guidance, so the app still works.
NAVIGATOR_WORKER_URL="https://samaritanlink-navigator.<your-subdomain>.workers.dev"

# --- Anthropic / Claude (optional alternative brain, server-side ONLY) ---
# Not required: the Navigator uses the Cloudflare Worker above by default.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# =====================================================================
# MA360 SamaritanLink — environment variables (EXAMPLE)
# Copy to `.env` for local development. NEVER commit the real `.env`.
# =====================================================================

# --- Application ---
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="MA360 SamaritanLink"

# --- Session / Auth ---
# Secret used to sign the demo session cookie. Generate a long random string.
SESSION_SECRET="replace-with-a-long-random-string"

# --- Database ---
# Local development (SQLite): file-based, zero setup.
#   DATABASE_URL="file:./dev.db"
# Production (PostgreSQL): e.g. Vercel Postgres / Neon / Supabase.
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
DATABASE_URL="file:./dev.db"

# --- Anthropic / Claude (server-side ONLY — never expose to the client) ---
# Used by the AI Health Navigation Assistant. The MVP runs on mock content
# when this is unset, so the app is fully demo-able without a key.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

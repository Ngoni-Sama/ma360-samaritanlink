// MA360 SamaritanLink — production schema (PostgreSQL / Neon).
// url = pooled connection (runtime, serverless); directUrl = direct (migrations).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity & providers
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  role         String // patient | health_worker | professional | pharmacy | laboratory | admin
  passwordHash String
  status       String   @default("active")
  providerId   String? // links provider-role users to a Provider
  createdAt    DateTime @default(now())
}

model Provider {
  providerId   String  @id
  name         String
  role         String // professional | pharmacy | laboratory | health_worker | nurse | admin
  profession   String
  specialty    String?
  facility     String
  location     String?
  registration String?
  category     String? // directory category key
  available    Boolean @default(true)
}

// ---------------------------------------------------------------------------
// Longitudinal patient record
// ---------------------------------------------------------------------------

model Patient {
  patientId        String   @id
  nationalId       String?
  name             String
  age              Int
  sex              String
  contact          String
  location         String
  emergencyContact String
  allergies        String[]
  alerts           String[]
  conditions       String[]
  createdAt        DateTime @default(now())

  medications Medication[]
  labResults  LabResult[]
  journey     JourneyEvent[]
  documents   Document[]
}

model Medication {
  id        String  @id @default(cuid())
  patientId String
  name      String
  dosage    String
  frequency String
  status    String
  pharmacy  String?
  patient   Patient @relation(fields: [patientId], references: [patientId], onDelete: Cascade)
}

model LabResult {
  id        String  @id @default(cuid())
  patientId String
  test      String
  value     String
  flag      String
  date      String
  patient   Patient @relation(fields: [patientId], references: [patientId], onDelete: Cascade)
}

model JourneyEvent {
  id             String  @id @default(cuid())
  patientId      String
  date           String
  stage          String
  title          String
  detail         String
  by             String
  status         String
  patientVisible Boolean @default(true)
  patient        Patient @relation(fields: [patientId], references: [patientId], onDelete: Cascade)
}

model Document {
  id        String  @id @default(cuid())
  patientId String
  name      String
  kind      String
  date      String
  patient   Patient @relation(fields: [patientId], references: [patientId], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Interactive workflows (server-persisted, cross-role, cross-device)
// ---------------------------------------------------------------------------

model Prescription {
  id          String   @id @default(cuid())
  patientId   String
  patientName String
  items       String
  pharmacy    String
  status      String // issued | received | preparing | ready | collected
  issuedBy    String
  createdAt   DateTime @default(now())
}

model LabRequest {
  id          String   @id @default(cuid())
  patientId   String
  patientName String
  tests       String
  lab         String
  requestedBy String
  status      String // requested | sample_collected | processing | results_ready | sent_to_doctor
  result      String?
  createdAt   DateTime @default(now())
}

model Appointment {
  id          String   @id @default(cuid())
  patientId   String
  patientName String
  purpose     String
  whenAt      String
  status      String // scheduled | confirmed | completed | missed | rescheduled
  createdAt   DateTime @default(now())
}

model Referral {
  id           String   @id @default(cuid())
  patientId    String
  patientName  String
  fromProvider String
  toProvider   String
  reason       String
  status       String // created | patient_notified | facility_identified | appointment | completed | followup
  createdAt    DateTime @default(now())
}

model HomeVisit {
  id          String   @id @default(cuid())
  patientId   String
  patientName String
  purpose     String
  whenAt      String
  status      String // scheduled | completed | escalated
  outcome     String?
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  recipient String // patient | doctor | pharmacy | laboratory
  channel   String // SMS | WhatsApp | In-app
  text      String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  timestamp DateTime @default(now())
}
